CONNECTLIFE_USERNAME=
CONNECTLIFE_PASSWORD=

DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=
DB_NAME=home_automation
DB_USER=
DB_PASSWORD=

POLL_INTERVAL_SECONDS=600
DASHBOARD_PORT=8081
DASHBOARD_SECRET_KEY=
GNUPLOT_BIN=/opt/homebrew/bin/gnuplot
MARIADB_DUMP_BIN=/opt/homebrew/bin/mariadb-dump
DATABASE_BACKUP_DIR=exports
DATABASE_BACKUP_TIME=03:00
DATABASE_BACKUP_KEEP=30

# Local analytics summary formatter. Disabled until Ollama is deliberately enabled.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
